# ============================================================
# Katalog Pribadiku - Contoh Environment Variable
# ============================================================
# Salin file ini menjadi ".env" lalu isi nilainya.
# Jangan pernah menyimpan nilai rahasia di dalam source code.
#
#   cp .env.example .env
#
# ------------------------------------------------------------
# FRONTEND (Vite) - dibaca oleh aplikasi React
# Prefiks "VITE_" wajib digunakan agar bisa diakses di browser.
# ------------------------------------------------------------

# URL API backend (Express + Neon). Jika dikosongkan, secara default
# aplikasi memakai "http://localhost:3001/api" saat development, dan
# otomatis fallback ke penyimpanan lokal (offline mode) jika server
# tidak dapat dijangkau - jadi aplikasi tetap bisa dijalankan tanpa
# konfigurasi apa pun.
VITE_API_URL=

# ------------------------------------------------------------
# BACKEND (Node/Express) - HANYA untuk server, tidak pernah diekpos
# ke browser. Simpan rahasia ini hanya di mesin server Anda.
# ------------------------------------------------------------
# Connection string Neon PostgreSQL (format: postgresql://user:pass@host/db?sslmode=require)
# Dapatkan di dashboard Neon: https://console.neon.tech
DATABASE_URL=

# Port server API (default: 3001)
PORT=3001

# Asal (origin) frontend yang diizinkan mengakses API (CORS)
CLIENT_ORIGIN=http://localhost:5173
